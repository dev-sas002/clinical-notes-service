# Copy to .env and adjust. Every value below is the built-in default.

# Async SQLAlchemy URL. SQLite is the tested default.
DATABASE_URL=sqlite+aiosqlite:///./data/carenotes.db
DB_ECHO=false

ENVIRONMENT=development
LOG_LEVEL=INFO

# Pagination guard rails
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Analytics cache. 0 disables caching.
ANALYTICS_CACHE_TTL_SECONDS=30
ANALYTICS_CACHE_MAX_ENTRIES=512

# Comma-separated CORS origins
CORS_ALLOW_ORIGINS=http://localhost:3000

# Seeding (used by `python -m app.seed`)
SEED_NOTES=5000
SEED_TENANTS=3
SEED_FACILITIES_PER_TENANT=4
SEED_PATIENTS_PER_FACILITY=25
SEED_DAYS=30
